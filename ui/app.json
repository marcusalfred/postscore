{
  "expo": {
    "name": "POSTscore",
    "slug": "postscore",
    "version": "1.0.0",
    "scheme": "postscore",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6db1513-e88c-4649-afd3-683dcc303dd4"
      }
    },
    "owner": "malfred",
    "ios": {
      "bundleIdentifier": "com.malfred.postscore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
